# Klient (exponeras i bundle — det är OK för Supabase anon key)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Dev-only: ElevenLabs Scribe för ord-tidsstämplar (scripts/transcribe-audio.js)
# ELEVENLABS_API_KEY=...

# Cloudflare Pages Function secrets (sätts via wrangler pages secret put / .dev.vars)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# ADMIN_PASSWORD=...   # genererat vid deploy — se README eller Cloudflare-dashboarden
# COOKIE_SECRET=...    # 32+ bytes random, för att signera cookien
